{
  "$schema": "http://json.schemastore.org/template",
  "defaultName": "NppPlugin",
  "description": "Plugin for Notepad++ (WPF)",
  "classifications": [ "Library", "Other", "Notepad++", "Desktop","Windows" ],
  "identity": "krenckel.nppplugin.wpf",
  "name": "Notepad++ Plugin (WPF)",
  "shortName": "NppPlugin.WPF",
  "tags": {
    "type": "project",
    "language": "C#"
  },
  "sourceName": "____NppPlugin____",
  "preferNameDirectory": true,
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "The target framework for the project.",
      "datatype": "choice",
      "enableQuotelessLiterals": true,
      "choices": [
	  	{
          "choice": "net9.0",
          "description": "Target .net9.0"
        },
        {
          "choice": "net8.0",
          "description": "Target .net8.0"
        },
        {
          "choice": "net7.0",
          "description": "Target .net7.0"
        },
        {
          "choice": "net6.0",
          "description": "Target .net6.0"
        }
      ],
      "replaces": "net8.0",
      "defaultValue": "net8.0"
    }
  }
}
